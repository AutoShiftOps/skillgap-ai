# OpenAI API key used for JD parsing, resume parsing, semantic matching prompts,
# cover letter generation, and interview question generation.
OPENAI_API_KEY=sk-your-key-here

# Model used for structured extraction + generation tasks.
OPENAI_MODEL=gpt-4o-mini

# Embedding model used for semantic skill matching (Phase 6+).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Postgres connection string from Supabase (Project Settings -> Database ->
# Connection string -> URI). Used for direct SQL access if needed; the app
# primarily talks to Supabase via its client libraries below.
DATABASE_URL=

# Supabase project URL and anon key (Project Settings -> API). Safe to expose
# client-side; Row Level Security policies protect the data.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service role key (Project Settings -> API). SERVER-SIDE ONLY.
# Bypasses Row Level Security -- never expose this to the client or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Max characters accepted for pasted JD text (guards against runaway prompt cost).
MAX_JD_CHARS=20000

# Max characters accepted for parsed resume text.
MAX_RESUME_CHARS=20000
