# OpenAI API key used for JD parsing, resume parsing, semantic matching prompts,
# cover letter generation, and interview question generation.
OPENAI_API_KEY=sk-your-key-here

# Model used for structured extraction + generation tasks.
OPENAI_MODEL=gpt-4o-mini

# Embedding model used for semantic skill matching (Phase 2+).
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Optional: Postgres connection string for persistence (Phase 3+, pgvector-enabled).
# Leave blank to run in stateless/in-memory mode for the MVP.
DATABASE_URL=

# Max characters accepted for pasted JD text (guards against runaway prompt cost).
MAX_JD_CHARS=20000

# Max characters accepted for parsed resume text.
MAX_RESUME_CHARS=20000
